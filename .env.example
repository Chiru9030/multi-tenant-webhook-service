# HTTP server listen port
PORT=8080
# SQLite WAL database file path (override ./webhooks.db locally, /app/data/webhooks.db in Docker/K8s)
DB_PATH=./webhooks.db
# API key protecting /v1/* tenant, endpoint, event, and replay APIs
WEBHOOK_ADMIN_API_KEY=replace_with_32byte_admin_key
# Comma-separated allowed CORS origins (leave * only for local dev)
ALLOWED_ORIGINS=https://dashboard.example.com
# Optional deterministic secret for seeded demo endpoint
DEMO_WEBHOOK_SECRET=replace_with_demo_whsec
